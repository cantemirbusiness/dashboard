# ---------------------------------------------------------------------------
# Supabase — Project Settings → API (both values are public by design;
# access is enforced by Row Level Security in the database).
# NEVER put the service_role key here or anywhere in this app.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…). Legacy projects can instead set
# NEXT_PUBLIC_SUPABASE_ANON_KEY with the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the deployed app, used in auth email links.
# Optional locally (falls back to the request host). Set it in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development only: `PREVIEW_MODE=demo npm run dev` renders the UI with
# in-memory demo data and no database (read-only). Ignored in production.
# PREVIEW_MODE=demo
